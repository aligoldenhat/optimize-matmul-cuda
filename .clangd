# clangd parses .cu files with clang's own CUDA support, not nvcc.
# compile_commands.json contains nvcc-only flags that clang doesn't know,
# so strip them and tell clang where CUDA is and which GPU to target.
CompileFlags:
  CompilationDatabase: build/debug
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -Xcompiler*
    - -lineinfo
    - -Wreorder
    - --Wext-lambda-captures-this
    - --Werror*
    - --options-file
  Add:
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_86
    - -Wno-unknown-cuda-version # clang may not know CUDA 13.1 yet
